{
  "expo": {
    "name": "ZestRoute",
    "slug": "zestroute-customer",
    "version": "1.0.0",
    "scheme": "zestroute",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android", "web"],
    "android": {
      "package": "com.zestroute.app",
      "adaptiveIcon": {
        "backgroundColor": "#F47B20"
      }
    },
    "ios": {
      "bundleIdentifier": "com.zestroute.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router"]
  }
}

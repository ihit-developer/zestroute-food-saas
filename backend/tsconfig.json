{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "@zestroute/shared": ["../shared/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "migrations/**/*.ts", "seed/**/*.ts", "tests/**/*.ts"]
}

# ==============================================================================
# Food Ordering & Delivery Platform - Backend Environment Template
# Copy to backend/.env and fill with real values in local/staging/production.
# NEVER commit real secrets or connection strings to version control.
# ==============================================================================

# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MongoDB Atlas (Primary Database - Replica Set required for ACID transactions)
MONGO_URI=mongodb+srv://admin:admin123@cluster0.p5wkchk.mongodb.net/FOOOD?retryWrites=true&w=majority
MONGODB_DB_NAME=food_delivery_platform

# Authentication & Sessions (JWT)
JWT_ACCESS_SECRET=e51436c431d070d0b4c5ff57a9c7a14538b9cd8d126ff0178dd2140bce4a1814
JWT_REFRESH_SECRET=2335b898a889aa3b70ea19aa39eb1b93fe74f2af967177468f5cf3a93818f616
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
PASSWORD_PEPPER=replace_with_optional_server_pepper

# CORS & Client Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8081,http://localhost:8082

# Media Storage (Cloudinary or S3-compatible)
STORAGE_PROVIDER=cloudinary
